# Configuración aplicada por Elastic Beanstalk en cada despliegue.
commands:
  01_data_dir:
    # Carpeta persistente para SQLite, propiedad del usuario sin privilegios del contenedor (uid 10001).
    command: mkdir -p /var/app/data && chown 10001:10001 /var/app/data

option_settings:
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
